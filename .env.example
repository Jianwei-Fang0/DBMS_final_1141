# ============================================
# NTU Venue Booking System - 環境變數配置範例
# ============================================
# ============================================
PG_DSN=postgresql://ntu:ntu@localhost:5432/ntu_venue_dev
# ============================================
# MongoDB 設定
# ============================================

MONGO_URI=mongodb://localhost:27017
# MONGODB_URI=mongodb://localhost:27017  # 替代選項

# MongoDB 資料庫名稱
# 預設：ntu_venue_logs
# 也可以使用：MONGODB_DB_NAME（兩者擇一即可）
MONGO_DB=ntu_process_logs

# ============================================
# FastAPI 服務設定（可選）
# ============================================
# FastAPI 服務監聽端口
# 預設：8000
PORT=8000